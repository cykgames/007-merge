; Engine configuration file.
config_version=5

[application]

config/name="007 Fruit Merge"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SaveData="*res://scripts/save_data.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=576
window/size/window_height_override=1024
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/cjk_font.tres"

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

2d_physics/layer_1="fruit"
2d_physics/layer_2="wall"

[physics]

2d/default_gravity=1250.0

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
